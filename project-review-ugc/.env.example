# Worker and controller: set the SAME private key (never commit .env).
UGC_REMOTE_API_KEY=
# Controller: RunPod HTTP service URL
UGC_REMOTE_API_URL=
# Controller TTS (preferred); persona voice_id can override the default voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional controller-managed GPU lifecycle; default UI mode is Manual.
RUNPOD_API_KEY=
RUNPOD_POD_ID=
RUNPOD_IDLE_SHUTDOWN_MINUTES=5
RUNPOD_MAX_SESSION_MINUTES=30
# Optional full OpenAI-compatible chat-completions endpoint
UGC_LLM_API_URL=
UGC_LLM_MODEL=
UGC_LLM_API_KEY=
# Worker: provision externally; bootstrap never downloads large weights.
# UGC_MODELS_DIR=/workspace/models
# UGC_PROJECTS_DIR=/workspace/projects
# UGC_ML_ENV_PYTHON=/opt/venv/bin/python3
# UGC_SYNCNET_WEIGHTS=/workspace/models/syncnet_v2.model
UGC_VIDEO_GPU=0
UGC_VIDEO_GPU_2=0
UGC_EVAL_GPU=0
UGC_TTS_GPU=0
# Set only when a real compatible transcription server is running.
# WHISPER_URL=http://localhost:8765
